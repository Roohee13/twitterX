# Database (local Postgres)
DB_URL=jdbc:postgresql://localhost:5432/xclone
DB_USER=postgres
DB_PASSWORD=postgres

# JWT (secret must be >= 32 bytes)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=xclone-media
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev
R2_PRESIGN_TTL=10m
R2_MAX_IMAGE_BYTES=5242880
